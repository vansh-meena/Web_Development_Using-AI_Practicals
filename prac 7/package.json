{
  "name": "product-catalogue-api",
  "version": "1.0.0",
  "private": true,
  "description": "RESTful API for a product catalogue (Node.js, Express, MongoDB/Mongoose)",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
