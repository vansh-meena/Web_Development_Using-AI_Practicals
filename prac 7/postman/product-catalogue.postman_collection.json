{
  "info": {
    "name": "Product Catalogue API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4007" },
    { "key": "productId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Body has status and db', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('status', 'ok');",
              "    pm.expect(body.db).to.be.oneOf(['connected', 'disconnected']);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?page=1&limit=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Body has data array and meta', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('data').that.is.an('array');",
              "    pm.expect(body.meta).to.have.property('page');",
              "    pm.expect(body.meta).to.have.property('limit');",
              "    pm.expect(body.meta).to.have.property('total');",
              "    pm.expect(body.meta).to.have.property('pages');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Widget\",\n  \"description\": \"Product created from the Postman collection.\",\n  \"category\": \"home\",\n  \"price\": 24.99,\n  \"quantity\": 5,\n  \"inStock\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Location header is set', function () {",
              "    pm.expect(pm.response.headers.get('Location')).to.include('/api/products/');",
              "});",
              "pm.test('Body returns created product', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.have.property('_id');",
              "    pm.expect(body.data.name).to.eql('Postman Test Widget');",
              "});",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('productId', body.data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get product by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Body returns the requested product', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data).to.have.property('_id', pm.collectionVariables.get('productId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Replace product (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Test Widget Updated\",\n  \"description\": \"Fully replaced via PUT.\",\n  \"category\": \"electronics\",\n  \"price\": 29.99,\n  \"quantity\": 10,\n  \"inStock\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Body returns the updated product', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.name).to.eql('Postman Test Widget Updated');",
              "    pm.expect(body.data.category).to.eql('electronics');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Patch product (partial update)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 19.99,\n  \"quantity\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Only patched fields changed', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.data.price).to.eql(19.99);",
              "    pm.expect(body.data.quantity).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204 with no body', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get deleted product (expect 404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "{{productId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('Body has error code NOT_FOUND', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error.code).to.eql('NOT_FOUND');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get invalid id (expect 400)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products/not-a-valid-id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "products", "not-a-valid-id"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Body has an error object', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.error).to.have.property('code');",
              "    pm.expect(body.error).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
